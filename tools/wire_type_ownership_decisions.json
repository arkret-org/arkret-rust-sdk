{
  "forbidden": [
    {
      "repository": "inkson",
      "path": "src/models.rs",
      "pattern": "struct\\s+RealmStateSnapshotBootstrapJson\\b",
      "owner": "arkret_sdk::RealmStateSnapshotBootstrap"
    },
    {
      "repository": "inkson",
      "path": "src/views/settings/devices.rs",
      "pattern": "struct\\s+(PairingServerChallengeCarrier|ResolvedPairingApprovalPayload)\\b",
      "owner": "arkret_sdk::DevicePairingBootstrap"
    },
    {
      "repository": "garth",
      "path_glob": "src/**/*.rs",
      "pattern": "source_actor_id\\s*:\\s*(?:(?:arkret_wire|arkret_sdk)::)?DidCoreId\\b",
      "owner": "arkret_wire::ActorId",
      "rationale": "The retired history_runtime.rs became authority commit-stream consumers in replica.rs and own_station_results.rs. Every Garth source must preserve the complete ActorId rather than a principal-only source selector."
    },
    {
      "repository": "garth",
      "path_glob": "src/**/*.rs",
      "pattern": "(?:struct|enum)\\s+(?:CommittedEventView|StreamScanOutcome|StreamScanRequest)\\b",
      "owner": "arkret_wire::{CommittedEventView, StreamScanOutcome, StreamScanRequest}",
      "rationale": "Current replicas and own-Station scan pages embed SDK-owned commit-stream carriers. Moving or adding a source must not recreate these wire DTOs locally."
    },
    {
      "repository": "soland",
      "path": "crates/http/src/routing/spaces/space.rs",
      "pattern": "struct\\s+RealmExport(Event|Operation|Outcome)\\b",
      "owner": "arkret_models_collaboration::governance::realm_governance::RealmExport"
    }
  ],
  "classified": [
    {
      "repository": "inkson",
      "path": "src/identity/device_pairing.rs",
      "pattern": "struct\\s+ResolvedPairingApproval\\b",
      "classification": "app_local_oob_handoff",
      "rationale": "Carries target-local proof material and embeds the SDK-owned bootstrap without copying server fields."
    },
    {
      "repository": "coauth",
      "path": "crates/admin-types/src/integration_manifest_admin.rs",
      "pattern": "struct\\s+IntegrationManifest",
      "classification": "deployment_private_admin_contract",
      "rationale": "The /_coauth administrative manifest is not an Arkret public wire surface."
    }
  ]
}
