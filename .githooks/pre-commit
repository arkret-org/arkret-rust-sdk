#!/usr/bin/env sh
set -eu

staged_paths=$(git diff --cached --name-only --diff-filter=ACMR)
rust_touched=$(printf '%s\n' "$staged_paths" | grep -E '(^Cargo\.toml$|^Cargo\.lock$|^crates/.+/(Cargo\.toml|.+\.rs)$)' || true)

if [ -z "$rust_touched" ]; then
    exit 0
fi

cargo +nightly fmt --all -- --check

workspace_touched=false
packages=

add_package() {
    case " $packages " in
        *" $1 "*) ;;
        *) packages="$packages $1" ;;
    esac
}

for path in $rust_touched; do
    case "$path" in
        Cargo.toml|Cargo.lock)
            workspace_touched=true
            ;;
        crates/crypto/*)
            add_package arkret-crypto
            ;;
        crates/http-client/*)
            add_package arkret-http-client
            ;;
        crates/identifiers/*)
            add_package arkret-identifiers
            ;;
        crates/sdk/*)
            add_package arkret
            ;;
        crates/server/*)
            add_package arkret-server
            ;;
        crates/signatures/*)
            add_package arkret-signatures
            ;;
        *)
            workspace_touched=true
            ;;
    esac
done

if [ "$workspace_touched" = true ]; then
    cargo clippy --workspace --all-targets --all-features
else
    for package in $packages; do
        cargo clippy -p "$package" --all-targets --all-features
    done
fi
