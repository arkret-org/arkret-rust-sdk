{
  "$schema": "./manifest.schema.json",
  "schema_version": 1,
  "train": {
    "id": "arkret-v1-main",
    "merge_order": [
      "arkret-spec",
      "arkret-rust-sdk",
      "floria",
      "soland",
      "coauth",
      "garth",
      "chime",
      "inkson",
      "cotest"
    ]
  },
  "repositories": {
    "arkret-spec": {
      "repository": "arkret-org/arkret-spec",
      "commit": "92bc3bb35a3a9848a93ed292b8366da514543934",
      "checkout_path": "arkret-spec",
      "roles": [
        "normative-artifacts",
        "operation-registry",
        "schemas"
      ]
    },
    "arkret-rust-sdk": {
      "repository": "arkret-org/arkret-rust-sdk",
      "commit": "d3131dfddb6d9a2d4312146739c3651ed189d9e4",
      "checkout_path": "arkret-rust-sdk",
      "roles": [
        "public-models",
        "generated-contracts",
        "shared-validators"
      ]
    },
    "floria": {
      "repository": "arkret-org/floria",
      "commit": "72ab0eb7989da84908fbfa16d5fc1a2d5b6b287c",
      "checkout_path": "floria",
      "roles": [
        "soland-build-dependency"
      ]
    },
    "soland": {
      "repository": "arkret-org/soland",
      "commit": "526104138d59007acf3e56457b87720bd9ec6cdd",
      "checkout_path": "soland",
      "roles": [
        "protocol-producer",
        "server"
      ]
    },
    "coauth": {
      "repository": "arkret-org/coauth",
      "commit": "1f3038a5b1b0e48775878bfc792aeee2fefa7ca3",
      "checkout_path": "coauth",
      "roles": [
        "identity-producer",
        "authorization-producer"
      ]
    },
    "garth": {
      "repository": "arkret-org/garth",
      "commit": "5419b7f0b4368410a7b776bc8389f0abffe09fed",
      "checkout_path": "garth",
      "roles": [
        "runtime-consumer"
      ]
    },
    "chime": {
      "repository": "arkret-org/chime",
      "commit": "7bc9678bd053b5877a53713e4bef002075db4ae2",
      "checkout_path": "chime",
      "roles": [
        "inkson-build-dependency"
      ]
    },
    "inkson": {
      "repository": "arkret-org/inkson",
      "commit": "3ede0be4085297d1880c1cb1435054ee4e93fd3d",
      "checkout_path": "inkson",
      "roles": [
        "application-consumer"
      ]
    },
    "cotest": {
      "repository": "arkret-org/cotest",
      "commit": "ed8f9869c078547b007040f4020ee3381fbff9a6",
      "checkout_path": "cotest",
      "roles": [
        "joint-contract-tests",
        "wire-type-mirror"
      ]
    }
  },
  "public_model_probes": [
    {
      "repository": "arkret-rust-sdk",
      "type": "arkret_wire::Event",
      "source": "crates/wire/src/event_envelope.rs",
      "required_fields": [
        "event_id",
        "kind",
        "realm_id",
        "scope_ref",
        "actor_id",
        "created_at",
        "payload",
        "producer_proof"
      ]
    }
  ],
  "artifact_probes": [
    {
      "repository": "arkret-spec",
      "kind": "operation",
      "name": "canonical operation registry",
      "path": "spec/v1/artifacts/registry/operation-registry.json"
    },
    {
      "repository": "arkret-spec",
      "kind": "registry",
      "name": "registry manifest",
      "path": "spec/v1/artifacts/registry/registry-manifest.json"
    },
    {
      "repository": "arkret-spec",
      "kind": "schema",
      "name": "event envelope",
      "path": "spec/v1/artifacts/schemas/event-envelope.schema.json"
    }
  ],
  "checks": [
    {
      "id": "sdk.protocol-type-names",
      "repository": "arkret-rust-sdk",
      "category": "static",
      "surface": {
        "kind": "type",
        "name": "protocol wrapper names and exact domain exceptions"
      },
      "working_directory": "arkret-rust-sdk",
      "command": [
        "python",
        "tools/lint-type-names.py"
      ]
    },
    {
      "id": "sdk.protocol-type-names-regression",
      "repository": "arkret-rust-sdk",
      "category": "static",
      "surface": {
        "kind": "type",
        "name": "protocol wrapper name gate itself"
      },
      "working_directory": "arkret-rust-sdk",
      "command": [
        "python",
        "tools/test_type_names.py"
      ]
    },
    {
      "id": "sdk.compatibility-runner-regression",
      "repository": "arkret-rust-sdk",
      "category": "static",
      "surface": {
        "kind": "type",
        "name": "compatibility manifest validation and check execution"
      },
      "working_directory": "arkret-rust-sdk",
      "command": [
        "python",
        "tools/test_compatibility_gate.py",
        "--tools-only"
      ]
    },
    {
      "id": "sdk.generated-contracts",
      "repository": "arkret-rust-sdk",
      "category": "static",
      "surface": {
        "kind": "schema",
        "name": "all registered spec schemas"
      },
      "working_directory": "arkret-rust-sdk",
      "command": [
        "python",
        "tools/schema_struct_gate.py",
        "--spec-root",
        "../arkret-spec/spec/v1/artifacts/schemas"
      ]
    },
    {
      "id": "sdk.wire-type-ownership",
      "repository": "arkret-rust-sdk",
      "category": "static",
      "surface": {
        "kind": "type",
        "name": "wire DTO ownership across consumers"
      },
      "working_directory": "arkret-rust-sdk",
      "command": [
        "python",
        "tools/wire_type_ownership_audit.py",
        "--workspace-root",
        "..",
        "--require-repository",
        "inkson",
        "--require-repository",
        "garth",
        "--require-repository",
        "soland",
        "--require-repository",
        "coauth"
      ]
    },
    {
      "id": "sdk.wire-type-ownership-regression",
      "repository": "arkret-rust-sdk",
      "category": "static",
      "surface": {
        "kind": "type",
        "name": "wire DTO ownership audit itself"
      },
      "working_directory": "arkret-rust-sdk",
      "command": [
        "python",
        "tools/test_wire_type_ownership_audit.py"
      ]
    },
    {
      "id": "sdk.dependency-matrix",
      "repository": "arkret-rust-sdk",
      "category": "static",
      "surface": {
        "kind": "type",
        "name": "cross-repository Cargo major versions"
      },
      "working_directory": "arkret-rust-sdk",
      "command": [
        "python",
        "tools/dep_matrix.py",
        "--workspace-root",
        "..",
        "--format",
        "text",
        "--fail-on-divergence",
        "--require-repository",
        "arkret-rust-sdk",
        "--require-repository",
        "soland",
        "--require-repository",
        "coauth",
        "--require-repository",
        "garth",
        "--require-repository",
        "inkson",
        "--require-repository",
        "cotest",
        "--require-repository",
        "floria",
        "--require-repository",
        "chime"
      ]
    },
    {
      "id": "sdk.dependency-matrix-regression",
      "repository": "arkret-rust-sdk",
      "category": "static",
      "surface": {
        "kind": "type",
        "name": "cross-repository dependency matrix generator itself"
      },
      "working_directory": "arkret-rust-sdk",
      "command": [
        "python",
        "tools/test_dep_matrix.py"
      ]
    },
    {
      "id": "sdk.test-kit-production-boundary",
      "repository": "arkret-rust-sdk",
      "category": "static",
      "surface": {
        "kind": "type",
        "name": "shared test-kit reachability from production builds"
      },
      "working_directory": "arkret-rust-sdk",
      "command": [
        "python",
        "tools/test_kit_production_gate.py",
        "--workspace-root",
        "..",
        "--require-repository",
        "soland",
        "--require-repository",
        "coauth",
        "--require-repository",
        "garth",
        "--require-repository",
        "inkson",
        "--require-repository",
        "cotest"
      ]
    },
    {
      "id": "sdk.test-kit-production-boundary-regression",
      "repository": "arkret-rust-sdk",
      "category": "static",
      "surface": {
        "kind": "type",
        "name": "shared test-kit production boundary gate itself"
      },
      "working_directory": "arkret-rust-sdk",
      "command": [
        "python",
        "tools/test_test_kit_production_gate.py"
      ]
    },
    {
      "id": "cotest.api-only-migration",
      "repository": "cotest",
      "category": "static",
      "surface": {
        "kind": "type",
        "name": "API-only Playwright ownership closed over Rust tests"
      },
      "working_directory": "cotest",
      "command": [
        "python",
        "scripts/check_api_only_migration.py"
      ]
    },
    {
      "id": "cotest.e2e-coverage-inventory",
      "repository": "cotest",
      "category": "static",
      "surface": {
        "kind": "type",
        "name": "generated E2E scenario inventory matches the tree"
      },
      "working_directory": "cotest",
      "command": [
        "pwsh",
        "-NoProfile",
        "-File",
        "scripts/generate-e2e-coverage.ps1",
        "-Check"
      ]
    },
    {
      "id": "sdk.compile",
      "repository": "arkret-rust-sdk",
      "category": "compile",
      "surface": {
        "kind": "type",
        "name": "arkret SDK public model surface"
      },
      "working_directory": "arkret-rust-sdk",
      "command": [
        "cargo",
        "check",
        "--workspace",
        "--all-targets",
        "--all-features",
        "--locked"
      ]
    },
    {
      "id": "soland.compile",
      "repository": "soland",
      "category": "compile",
      "surface": {
        "kind": "type",
        "name": "Soland SDK producer integration"
      },
      "working_directory": "soland",
      "command": [
        "cargo",
        "check",
        "--workspace",
        "--all-targets",
        "--locked"
      ]
    },
    {
      "id": "coauth.compile",
      "repository": "coauth",
      "category": "compile",
      "surface": {
        "kind": "type",
        "name": "Coauth SDK producer integration"
      },
      "working_directory": "coauth",
      "command": [
        "cargo",
        "check",
        "--workspace",
        "--all-targets",
        "--locked"
      ]
    },
    {
      "id": "garth.compile",
      "repository": "garth",
      "category": "compile",
      "surface": {
        "kind": "type",
        "name": "Garth SDK consumer integration"
      },
      "working_directory": "garth",
      "command": [
        "cargo",
        "check",
        "--workspace",
        "--all-targets",
        "--locked"
      ]
    },
    {
      "id": "inkson.compile",
      "repository": "inkson",
      "category": "compile",
      "surface": {
        "kind": "type",
        "name": "Inkson SDK and Garth consumer integration"
      },
      "working_directory": "inkson",
      "command": [
        "cargo",
        "check",
        "--workspace",
        "--all-targets",
        "--locked"
      ]
    },
    {
      "id": "cotest.compile",
      "repository": "cotest",
      "category": "compile",
      "surface": {
        "kind": "type",
        "name": "Cotest Rust conformance integration"
      },
      "working_directory": "cotest",
      "command": [
        "cargo",
        "check",
        "--workspace",
        "--all-targets",
        "--all-features",
        "--locked"
      ]
    },
    {
      "id": "cotest.typecheck",
      "repository": "cotest",
      "category": "contract",
      "surface": {
        "kind": "type",
        "name": "Cotest TypeScript wire consumers"
      },
      "working_directory": "cotest/e2e",
      "command": [
        "npm",
        "run",
        "typecheck"
      ]
    },
    {
      "id": "cotest.wire-types",
      "repository": "cotest",
      "category": "contract",
      "surface": {
        "kind": "schema",
        "name": "generated Cotest wire objects"
      },
      "working_directory": "cotest/e2e",
      "command": [
        "npm",
        "run",
        "check:wire-types"
      ]
    },
    {
      "id": "cotest.joint-smoke",
      "repository": "cotest",
      "category": "contract",
      "surface": {
        "kind": "operation",
        "name": "joint identity login and recovery operations"
      },
      "working_directory": "cotest",
      "command": [
        "pwsh",
        "-File",
        "./scripts/run-joint-e2e.ps1",
        "-SolandRuntime",
        "docker",
        "-SolandImage",
        "cotest-soland:compatibility",
        "-StartCoauth",
        "-SkipNpmInstall",
        "-SkipBrowserInstall",
        "-RunProfile",
        "joint-smoke",
        "-PlaywrightProject",
        "joint-inkson",
        "-Grep",
        "@returning-login-gate|@onboarding-recovery-gate",
        "-RequireScenario",
        "identity/oidc-login-flow.spec.ts",
        "-ForbidSkippedTests"
      ]
    }
  ],
  "policy": {
    "forbidden_compatibility_techniques": [
      "consumer-local-compatibility-dto",
      "dual-read-fallback",
      "permissive-extra-fields"
    ],
    "required_status_check": "atomic compatibility / exact manifest gate",
    "source_guards": [
      {
        "id": "no-consumer-local-compatibility-dto",
        "repositories": [
          "soland",
          "coauth",
          "garth",
          "inkson",
          "cotest"
        ],
        "pattern": "(?i)\\bcompat(?:ibility)?[_ -]?dto\\b"
      },
      {
        "id": "no-dual-read-fallback",
        "repositories": [
          "soland",
          "coauth",
          "garth",
          "inkson",
          "cotest"
        ],
        "pattern": "(?i)\\bdual[_ -]?read(?:ing)?\\b"
      },
      {
        "id": "no-permissive-flattened-extra",
        "repositories": [
          "soland",
          "coauth",
          "garth",
          "inkson",
          "cotest"
        ],
        "pattern": "(?is)#\\[serde\\([^]]*flatten[^]]*\\)\\]\\s*(?:pub\\s+)?(?:extra|additional|unknown)\\b",
        "allow_paths": [
          "coauth/crates/backend/src/services/email_webhook.rs"
        ]
      }
    ]
  }
}
