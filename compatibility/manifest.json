  "policy": {
    "forbidden_compatibility_techniques": [
      "consumer-local-compatibility-dto",
      "dual-read-fallback",
      "permissive-extra-fields"
    ],
    "required_status_check": "atomic compatibility / exact manifest gate",
    "source_guards": [
      {
        "id": "no-consumer-local-compatibility-dto",
        "repositories": [
          "coland",
          "coauth",
          "garth",
          "inkson",
          "cotest"
        ],
        "pattern": "(?i)\\bcompat(?:ibility)?[_ -]?dto\\b"
      },
      {
        "id": "no-dual-read-fallback",
        "repositories": [
          "coland",
          "coauth",
          "garth",
          "inkson",
          "cotest"
        ],
        "pattern": "(?i)\\bdual[_ -]?read(?:ing)?\\b"
      },
      {
        "id": "no-permissive-flattened-extra",
        "repositories": [
          "coland",
          "coauth",
          "garth",
          "inkson",
          "cotest"
        ],
        "pattern": "(?is)#\\[serde\\([^]]*flatten[^]]*\\)\\]\\s*(?:pub\\s+)?(?:extra|additional|unknown)\\b",
        "allow_paths": [
          "coauth/crates/backend/src/services/email_webhook.rs"
        ]
      }
    ]
  }
}
